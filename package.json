{
  "name": "smart-exam-security",
  "version": "1.0.0",
  "description": "High-Concurrency Smart Examination Platform with Anti-Malpractice Forensics and Dynamic Watermarking",
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "build:client": "cd client && npm run build",
    "build": "cd client && npm install && npm run build",
    "seed": "node server/seed.js",
    "start": "node server/server.js",
    "test": "node server/run_tests.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "sql.js": "^1.17.0",
    "uuid": "^14.0.3"
  },
  "keywords": [
    "exam",
    "college",
    "anti-cheating",
    "watermark",
    "pdf-security",
    "proctoring"
  ],
